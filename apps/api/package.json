{
  "name": "@construction/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.988.0",
    "@aws-sdk/s3-request-presigner": "^3.988.0",
    "@casl/ability": "^6.8.0",
    "@clerk/backend": "^2.30.1",
    "@construction/shared": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@trpc/server": "^11.10.0",
    "bullmq": "^5.69.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.0",
    "intuit-oauth": "^4.2.2",
    "ioredis": "^5.9.3",
    "node-quickbooks": "^2.0.48",
    "papaparse": "^5.5.3",
    "pg": "^8.18.0",
    "puppeteer": "^24.37.3",
    "svix": "^1.84.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
